# Порт сервера
PORT=3000

# ── Обязательные секреты ─────────────────────────────────────────────
# Без них приложение не стартует. Значений по умолчанию нет намеренно.

# Секрет для JWT токенов. Сгенерировать стойкую строку:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
JWT_SECRET=

# Подключение к базе Turso (панель Turso → база → Connect)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Эти секреты на Vercel задаются в Project → Settings → Environment Variables
# (окружения Production/Preview/Development), локально — в этом файле .env.
# NODE_ENV / VERCEL / VERCEL_ENV Vercel выставляет сам — вручную не задавать.

# ── Только для офлайн-скриптов src/tools/generateDataBundle.js и cleanTurso.js ────
# Сервер их не читает. Нужны, только если вы сами запускаете эти скрипты вручную —
# без них они откажутся выставлять пароль admin/cb на известное значение.
ADMIN_PASSWORD=
CB_PASSWORD=

# ── Остальное ────────────────────────────────────────────────────────

# Telegram Bot Token (от @BotFather). Без него бот просто не включается —
# приложение прекрасно работает и без Telegram.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес приложения — по нему Telegram регистрирует вебхук
# (curl https://<адрес>/api/telegram/webhook). На Vercel — прод-домен проекта
# (напр. https://farovon-market-analysis.vercel.app), не localhost: с localhost
# вебхук не регистрируется вообще. Также попадает в CORS-allowlist (server.js).
WEBAPP_URL=http://localhost:3000

# Необязательно: список origin'ов для CORS через запятую. По умолчанию —
# WEBAPP_URL + web.telegram.org + старый домен Render (пока он держится
# запасным). На Vercel обычно достаточно дефолта.
# CORS_ORIGINS=https://farovon-market-analysis.vercel.app,https://web.telegram.org

# Секрет вебхука — Telegram присылает его в каждом запросе, так проверяем, что
# запрос действительно от Telegram, а не от кого угодно. Сгенерировать так же,
# как JWT_SECRET. Обязателен, если задан TELEGRAM_BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=

# Режим работы (development / production)
NODE_ENV=development
