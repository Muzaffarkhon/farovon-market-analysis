# Порт сервера
PORT=3000

# Секрет для JWT токенов (сгенерированная стойкая строка)
JWT_SECRET=farovon_secure_jwt_secret_key_2024_production_ready

# Подключение к базе Turso (используем локальную SQLite для демонстрации)
TURSO_DATABASE_URL=file:/app/data/market.db
TURSO_AUTH_TOKEN=

# Telegram Bot Token (от @BotFather) - оставьте пустым для локального запуска
TELEGRAM_BOT_TOKEN=

# URL веб-приложения
WEBAPP_URL=http://localhost:3000

# Режим работы
NODE_ENV=production

# Пароли для офлайн-скриптов
ADMIN_PASSWORD=admin123
CB_PASSWORD=cb123
